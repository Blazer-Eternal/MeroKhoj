# ============================================
# MeroKhoj Backend — Environment Variables
# Copy this file to .env and fill in real values.
# ============================================

# --- Runtime ---
NODE_ENV=development
PORT=8000
API_VERSION=v1

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=merokhoj
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false
DB_SSL=false

# --- JWT ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-access
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# --- CORS ---
# Comma-separated list of allowed origins. Use * for development.
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=10

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- SMTP (email verification / OTP / resets) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@merokhoj.com
SMTP_PASSWORD=change-me
SMTP_FROM="MeroKhoj <noreply@merokhoj.com>"

# --- File uploads / storage ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
